{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cocoa-County/taxmap-resources/main/schema/resource.schema.json",
  "title": "Reusable jurisdiction resources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "jurisdiction", "resources"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "region"],
      "properties": {
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "region": {"type": "string", "pattern": "^[A-Z0-9-]{2,8}$"},
        "county": {"$ref": "#/$defs/text"},
        "city": {"$ref": "#/$defs/text"}
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "authority", "source_url", "verification"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {
            "enum": ["official_website", "tax_bill", "parcel_gis", "assessment_gis", "boundary_gis", "agenda_minutes", "open_data"]
          },
          "label": {"$ref": "#/$defs/text"},
          "authority": {"$ref": "#/$defs/text"},
          "url": {"$ref": "#/$defs/url"},
          "url_template": {"$ref": "#/$defs/url"},
          "source_url": {"$ref": "#/$defs/url"},
          "apn_format": {"type": "string", "pattern": "^#+(?:-#+)*$"},
          "apn_field": {"$ref": "#/$defs/text"},
          "year_behavior": {"enum": ["current_county_year", "selectable_in_portal", "unknown"]},
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "checked_on", "method", "notes"],
            "properties": {
              "status": {"enum": ["verified", "access_limited", "unverified"]},
              "checked_on": {"type": "string", "format": "date"},
              "method": {"$ref": "#/$defs/text"},
              "notes": {"$ref": "#/$defs/text"}
            }
          }
        },
        "oneOf": [
          {"required": ["url"], "not": {"required": ["url_template"]}},
          {"required": ["url_template", "apn_format"], "not": {"required": ["url"]}}
        ],
        "allOf": [
          {
            "if": {"required": ["url_template"]},
            "then": {"properties": {"kind": {"const": "tax_bill"}}}
          },
          {
            "if": {"properties": {"kind": {"const": "tax_bill"}}},
            "then": {"required": ["year_behavior"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "url": {"type": "string", "minLength": 1, "maxLength": 2048}
  }
}
